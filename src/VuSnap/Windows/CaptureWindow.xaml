<Window x:Class="VuSnap.Windows.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="False" Background="Black" Cursor="Cross"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="Window_KeyDown">
  <Window.Resources>
    <Style x:Key="MIcon" TargetType="mi:MaterialIcon">
      <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <SolidColorBrush x:Key="BarBrush" Color="#FF262626"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="ActiveBrush" Color="#FF000000"/>

    <!-- Nút trên toolbar: ToggleButton phẳng, nền tối -->
    <Style x:Key="BarButton" TargetType="ToggleButton">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource ActiveBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Icon" TargetType="Path">
      <Setter Property="Stroke" Value="White"/>
      <Setter Property="StrokeThickness" Value="1.8"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Stretch" Value="None"/>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" Background="Black"
        MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseMove="Root_MouseMove" MouseLeftButtonUp="Root_MouseLeftButtonUp" MouseLeave="Root_MouseLeave" MouseWheel="Root_MouseWheel">
    <Image x:Name="Screenshot" Stretch="Fill" IsHitTestVisible="False"/>
    <!-- Lớp phủ tối, khoét lỗ ở vùng chọn -->
    <Path x:Name="Dim" Fill="#99000000" IsHitTestVisible="False"/>

    <!-- Annotation: tọa độ theo cửa sổ, bị cắt theo vùng chọn -->
    <Canvas x:Name="AnnotationHost" Background="Transparent">
      <Canvas x:Name="Ink"/>
      <Rectangle x:Name="GridView" IsHitTestVisible="False" Visibility="Collapsed"/>
    </Canvas>

    <Canvas x:Name="Overlay">
      <Rectangle x:Name="Selection" Stroke="#FF0A64FF" StrokeThickness="1" StrokeDashArray="3 2" Visibility="Collapsed" IsHitTestVisible="False"/>
      <Rectangle x:Name="AnnOutline" Stroke="#FF0A64FF" StrokeThickness="1" StrokeDashArray="4 3" Visibility="Collapsed" IsHitTestVisible="False"/>

      <!-- Thanh thao tác nhanh gần object đang chọn -->
      <Border x:Name="ObjBar" Background="{StaticResource BarBrush}" CornerRadius="4" Visibility="Collapsed" Cursor="Arrow" MouseLeftButtonDown="Swallow">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="DupButton" Style="{StaticResource ActionButton}" Width="34" Height="34" Click="Dup_Click">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="ContentDuplicate" Width="20" Height="20"/>
          </Button>
          <Button x:Name="RotateButton" Style="{StaticResource ActionButton}" Width="34" Height="34" Click="Rotate_Click">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="RotateRight" Width="20" Height="20"/>
          </Button>
          <Button x:Name="FlipHButton" Style="{StaticResource ActionButton}" Width="34" Height="34" Click="FlipH_Click">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="FlipHorizontal" Width="20" Height="20"/>
          </Button>
          <Button x:Name="FlipVButton" Style="{StaticResource ActionButton}" Width="34" Height="34" Click="FlipV_Click">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="FlipVertical" Width="20" Height="20"/>
          </Button>
          <Button x:Name="ObjDeleteButton" Style="{StaticResource ActionButton}" Width="34" Height="34" Click="LayerDelete_Click">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="DeleteOutline" Width="20" Height="20"/>
          </Button>
        </StackPanel>
      </Border>

      <!-- Toolbar dọc -->
      <Border x:Name="ToolBar" Background="{StaticResource BarBrush}" Visibility="Collapsed" Cursor="Arrow" MouseLeftButtonDown="Swallow">
        <StackPanel x:Name="ToolPanel">
          <ToggleButton Style="{StaticResource BarButton}" Tag="Select" Click="Tool_Click" ToolTip="Chọn / di chuyển layer (V)">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="CursorMove"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource BarButton}" Tag="Text" Click="Tool_Click" ToolTip="Chữ (T)">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="FormatText"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource BarButton}" Tag="Pen" Click="Tool_Click" ToolTip="Bút vẽ (P)">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="Pencil"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource BarButton}" Tag="Line" Click="Tool_Click" ToolTip="Đường thẳng (L)">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="VectorLine"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource BarButton}" Tag="Arrow" Click="Tool_Click" ToolTip="Mũi tên (A)">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="ArrowTopRight"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource BarButton}" Tag="Rectangle" Click="Tool_Click" ToolTip="Hình chữ nhật (R)">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="RectangleOutline"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource BarButton}" Tag="Ellipse" Click="Tool_Click" ToolTip="Hình elip (E)">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="EllipseOutline"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource BarButton}" Tag="Highlight" Click="Tool_Click" ToolTip="Đánh dấu (H)">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="FormatColorHighlight" Foreground="#FFFFE600"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource BarButton}" Tag="Blur" Click="Tool_Click" ToolTip="Làm mờ / pixelate (B)">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="Blur" Foreground="#FF4C9AFF"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource BarButton}" Tag="Invert" Click="Tool_Click" ToolTip="Tương phản / đảo màu vùng chọn (I)">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="InvertColors"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource BarButton}" Tag="Ruler" Click="Tool_Click" ToolTip="Thước đo pixel (M)">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="Ruler"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource BarButton}" Tag="Number" Click="Tool_Click" ToolTip="Đánh số (N)">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="Numeric1CircleOutline"/>
          </ToggleButton>
          <ToggleButton Style="{StaticResource BarButton}" Tag="Magnifier" Click="Tool_Click" ToolTip="Kính lúp (Z)">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="MagnifyPlusOutline"/>
          </ToggleButton>
          <Button x:Name="RatioButton" Style="{StaticResource ActionButton}" Click="Ratio_Click">
            <Grid Width="40" Height="40">
              <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="AspectRatio"/>
              <TextBlock x:Name="RatioLabel" FontSize="9" Foreground="#FFAAAAAA" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,1" IsHitTestVisible="False"/>
            </Grid>
          </Button>
          <Border Background="#FF000000" Width="40" Height="40">
            <ToggleButton x:Name="ColorButton" Style="{StaticResource BarButton}" Click="ColorButton_Click" ToolTip="Chọn màu, nét vẽ" Background="Transparent">
              <Grid Width="26" Height="26">
                <Ellipse Fill="White"/>
                <Ellipse x:Name="ColorDot" Fill="Red" Width="8" Height="8"/>
              </Grid>
            </ToggleButton>
          </Border>
          <ToggleButton x:Name="PanelButton" Style="{StaticResource BarButton}" Click="Panel_Click" ToolTip="Bảng thuộc tính &amp; layer">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="TuneVariant"/>
          </ToggleButton>
          <Button x:Name="RedoButton" Style="{StaticResource ActionButton}" Click="Redo_Click">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="Redo"/>
          </Button>
          <Button x:Name="UndoButton" Style="{StaticResource ActionButton}" Click="Undo_Click" ToolTip="Hoàn tác (Ctrl+Z)">
            <mi:MaterialIcon Style="{StaticResource MIcon}" Kind="Undo"/>
          </Button>
        </StackPanel>
      </Border>

      <!-- Thanh action dưới -->
      <Border x:Name="ActionBar" Background="{StaticResource BarBrush}" Visibility="Collapsed" Cursor="Arrow" MouseLeftButtonDown="Swallow">
        <StackPanel x:Name="ActionPanel" Orientation="Horizontal">
          <Button Style="{StaticResource ActionButton}" Click="Close_Click" ToolTip="Hủy (Esc)"><mi:MaterialIcon Style="{StaticResource MIcon}" Kind="Close" Width="20" Height="20"/></Button>
          <Button Style="{StaticResource ActionButton}" Click="SaveAs_Click" ToolTip="Lưu thành..."><mi:MaterialIcon Style="{StaticResource MIcon}" Kind="ContentSaveEdit"/></Button>
          <Button Style="{StaticResource ActionButton}" Click="QuickSave_Click" ToolTip="Lưu nhanh vào thư mục ảnh (Ctrl+S)"><mi:MaterialIcon Style="{StaticResource MIcon}" Kind="ContentSave"/></Button>
          <Button Style="{StaticResource ActionButton}" Click="Copy_Click" ToolTip="Copy (Ctrl+C)"><mi:MaterialIcon Style="{StaticResource MIcon}" Kind="ContentCopy"/></Button>
          <Button Style="{StaticResource ActionButton}" Click="Copy_Click" ToolTip="Hoàn tất &amp; copy (Enter)"><mi:MaterialIcon Style="{StaticResource MIcon}" Kind="Check" Foreground="#FF22C55E" Width="24" Height="24"/></Button>
        </StackPanel>
      </Border>

      <!-- Bảng chọn màu + độ dày -->
      <Border x:Name="ColorPanel" Background="White" Visibility="Collapsed" Padding="8,8,8,6" Cursor="Arrow" MouseLeftButtonDown="Swallow">
        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.35"/></Border.Effect>
        <StackPanel Width="190">
          <UniformGrid x:Name="Swatches" Rows="1"/>
          <Grid Margin="0,10,0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
            <Slider x:Name="SizeSlider" Minimum="1" Maximum="40" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="SizeSlider_Changed"/>
            <TextBlock x:Name="SizeText" Grid.Column="1" Text="3" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FF444444"/>
          </Grid>
        </StackPanel>
      </Border>

      <Border x:Name="FlyPanel" Background="White" Visibility="Collapsed" Padding="4" Cursor="Arrow" MouseLeftButtonDown="Swallow">
        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.35"/></Border.Effect>
        <StackPanel x:Name="FlyList" MinWidth="150"/>
      </Border>

      <Border x:Name="Loupe" Visibility="Collapsed" IsHitTestVisible="False" Background="#EE181818" CornerRadius="6"
              BorderBrush="#FF0A64FF" BorderThickness="1" Padding="4">
        <StackPanel>
          <Grid Width="136" Height="136">
            <Rectangle x:Name="LoupeView" Width="136" Height="136"/>
            <Rectangle Width="10" Height="10" Stroke="Black" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Rectangle Width="8" Height="8" Stroke="White" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,5,0,1">
            <Border x:Name="LoupeSwatch" Width="14" Height="14" BorderBrush="White" BorderThickness="1" Margin="0,0,6,0"/>
            <TextBlock x:Name="LoupeText" Foreground="White" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="SizeBadge" Background="#CC000000" CornerRadius="3" Padding="6,2" Visibility="Collapsed" IsHitTestVisible="False">
        <TextBlock x:Name="SizeBadgeText" Foreground="White" FontSize="12"/>
      </Border>
    </Canvas>

    <!-- Bảng thuộc tính bên phải -->
    <Border x:Name="SidePanel" Width="250" HorizontalAlignment="Right" Background="{StaticResource BarBrush}" Visibility="Collapsed"
            Cursor="Arrow" MouseLeftButtonDown="Swallow" TextElement.Foreground="#FFE5E5E5" TextElement.FontSize="12">
      <Border.Resources>
        <!-- Kiểu tối cho các control trong bảng thuộc tính (trước đây dùng kiểu sáng mặc định) -->
        <SolidColorBrush x:Key="PInput" Color="#FF1C1C1C"/>
        <SolidColorBrush x:Key="PBorder" Color="#FF4A4A4A"/>
        <SolidColorBrush x:Key="PText" Color="#FFE5E5E5"/>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource PText}"/></Style>
        <Style TargetType="ComboBoxItem">
          <Setter Property="Foreground" Value="{StaticResource PText}"/>
          <Setter Property="Padding" Value="8,5"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FF3A3A3A"/></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FF0A64FF"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="ComboBox">
          <Setter Property="Foreground" Value="{StaticResource PText}"/>
          <Setter Property="MinHeight" Value="26"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ComboBox">
                <Grid>
                  <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="5" Background="{StaticResource PInput}" BorderBrush="{StaticResource PBorder}" BorderThickness="1">
                          <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Data="M0,0 L4,4 L8,0" Stroke="#FFCCCCCC" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#FF0A64FF"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                  <ContentPresenter IsHitTestVisible="False" Margin="8,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                    Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    TextElement.Foreground="{TemplateBinding Foreground}"/>
                  <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" Placement="Bottom">
                    <Border MinWidth="{Binding ActualWidth, ElementName=Toggle}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,3,0,0" CornerRadius="6"
                            Background="#FF2B2B2B" BorderBrush="{StaticResource PBorder}" BorderThickness="1">
                      <ScrollViewer Margin="2"><ItemsPresenter/></ScrollViewer>
                    </Border>
                  </Popup>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="PanelToggle" TargetType="ToggleButton">
          <Setter Property="Foreground" Value="{StaticResource PText}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Bd" CornerRadius="5" Background="#FF3A3A3A" BorderBrush="{StaticResource PBorder}" BorderThickness="1">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
                  <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#FF0A64FF"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF0A64FF"/>
                    <Setter Property="Foreground" Value="White"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Border.Resources>
      <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock x:Name="PropsTitle" Text="Thuộc tính" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <Grid><TextBlock x:Name="PSizeLabel" Text="Độ dày nét / cỡ"/><TextBlock x:Name="PSizeText" Text="3" HorizontalAlignment="Right"/></Grid>
          <Slider x:Name="PSizeSlider" Minimum="1" Maximum="40" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="PSize_Changed"/>
          <Grid Margin="0,6,0,0"><TextBlock x:Name="POpacityLabel" Text="Độ đậm (opacity)"/><TextBlock x:Name="POpacityText" Text="100%" HorizontalAlignment="Right"/></Grid>
          <Slider x:Name="POpacitySlider" Minimum="5" Maximum="100" Value="100" ValueChanged="POpacity_Changed"/>
          <TextBlock x:Name="PStyleLabel" Margin="0,6,0,3"/>
          <ComboBox x:Name="PStyleBox" SelectionChanged="PStyle_Changed"/>
          <TextBlock x:Name="PArrowLabel" Margin="0,6,0,3"/>
          <ComboBox x:Name="PArrowBox" SelectionChanged="PArrow_Changed"/>
          <TextBlock x:Name="PLineTypeLabel" Margin="0,6,0,3"/>
          <ComboBox x:Name="PLineTypeBox" SelectionChanged="PLineType_Changed"/>
          <CheckBox x:Name="PCornersBox" Margin="0,10,0,0" Click="PCorners_Click"/>
          <TextBlock x:Name="PFontLabel" Margin="0,6,0,3"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="PFontBox" DropDownOpened="PFont_DropDownOpened" SelectionChanged="PFont_Changed"/>
            <ComboBox x:Name="PWeightBox" Grid.Column="1" Width="86" Margin="4,0,0,0" SelectionChanged="PWeight_Changed"/>
            <ToggleButton x:Name="PItalicButton" Style="{StaticResource PanelToggle}" Grid.Column="2" Content="I" FontStyle="Italic" Width="30" Margin="4,0,0,0" Focusable="False" Click="PItalic_Click"/>
          </Grid>
          <TextBlock x:Name="PColorLabel" Text="Màu" Margin="0,8,0,4"/>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="PColorSwatch" Width="24" Height="24" CornerRadius="3" BorderBrush="#66FFFFFF" BorderThickness="1" HorizontalAlignment="Left"/>
            <TextBox x:Name="PHex" Grid.Column="1" Text="#FF0000" Background="#FF1A1A1A" Foreground="White" BorderBrush="#FF444444" Padding="4,3" KeyDown="PHex_KeyDown" LostFocus="PHex_LostFocus"/>
          </Grid>
          <Grid x:Name="SvBox" Width="226" Height="130" Background="Red" Cursor="Cross" MouseLeftButtonDown="Sv_Down" MouseMove="Sv_Move" MouseLeftButtonUp="Sv_Up">
            <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
            <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="#FF000000" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
            <Canvas IsHitTestVisible="False"><Ellipse x:Name="SvMarker" Width="12" Height="12" Stroke="White" StrokeThickness="2"/></Canvas>
          </Grid>
          <Grid x:Name="HueBar" Width="226" Height="16" Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonDown="Hue_Down" MouseMove="Hue_Move" MouseLeftButtonUp="Hue_Up">
            <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#FFFF0000" Offset="0"/><GradientStop Color="#FFFFFF00" Offset="0.1667"/><GradientStop Color="#FF00FF00" Offset="0.3333"/>
              <GradientStop Color="#FF00FFFF" Offset="0.5"/><GradientStop Color="#FF0000FF" Offset="0.6667"/><GradientStop Color="#FFFF00FF" Offset="0.8333"/><GradientStop Color="#FFFF0000" Offset="1"/>
            </LinearGradientBrush></Rectangle.Fill></Rectangle>
            <Canvas IsHitTestVisible="False"><Rectangle x:Name="HueMarker" Width="4" Height="16" Fill="White" Stroke="Black" StrokeThickness="1"/></Canvas>
          </Grid>
          <WrapPanel x:Name="PSwatches" Margin="0,8,0,0"/>

          <!-- Lưới căn chỉnh -->
          <CheckBox x:Name="PGridBox" Margin="0,14,0,0" Click="PGrid_Click"/>
          <StackPanel x:Name="PGridOptions" Visibility="Collapsed" Margin="0,6,0,0">
            <Grid><TextBlock x:Name="PGridSizeLabel"/><TextBlock x:Name="PGridSizeText" HorizontalAlignment="Right"/></Grid>
            <Slider x:Name="PGridSizeSlider" Minimum="5" Maximum="100" Value="20" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="PGridSize_Changed"/>
            <TextBlock x:Name="PGridTypeLabel" Margin="0,6,0,3"/>
            <ComboBox x:Name="PGridTypeBox" SelectionChanged="PGridType_Changed"/>
          </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource ActionButton}" Width="30" Height="28" Click="LayerDelete_Click" x:Name="LayerDeleteButton"><mi:MaterialIcon Style="{StaticResource MIcon}" Kind="DeleteOutline" Width="18" Height="18"/></Button>
              <Button Style="{StaticResource ActionButton}" Width="30" Height="28" Click="LayerUp_Click" x:Name="LayerUpButton"><mi:MaterialIcon Style="{StaticResource MIcon}" Kind="ArrowUp" Width="18" Height="18"/></Button>
              <Button Style="{StaticResource ActionButton}" Width="30" Height="28" Click="LayerDown_Click" x:Name="LayerDownButton"><mi:MaterialIcon Style="{StaticResource MIcon}" Kind="ArrowDown" Width="18" Height="18"/></Button>
            </StackPanel>
            <TextBlock x:Name="LayersTitle" Text="Layer" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <Border Grid.Row="1" Background="#FF1A1A1A" Margin="0,6,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="LayerList"/></ScrollViewer>
          </Border>
        </Grid>

        <Button x:Name="PanelCloseButton" Grid.Row="2" Content="Đóng" Margin="0,10,0,0" Padding="0,5" Click="Panel_Click" Focusable="False"/>
      </Grid>
    </Border>

    <Border x:Name="Hint" VerticalAlignment="Top" HorizontalAlignment="Center" Background="#DD111827" CornerRadius="8" Padding="12,7" Margin="0,18,0,0" IsHitTestVisible="False">
      <TextBlock x:Name="HintText" Foreground="White" Text="Kéo để chọn vùng  ·  Esc để hủy"/>
    </Border>
  </Grid>
</Window>
