<Window x:Class="VuSnap.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#FFF7F8FA"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FF172033"/>
    <SolidColorBrush x:Key="BorderBrushX" Color="#FFD5D9E0"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,7"/><Setter Property="Cursor" Value="Hand"/></Style>
  </Window.Resources>
  <StackPanel Margin="26,24,26,22">
    <!-- Logo app (PNG có viền trong suốt nên kéo lệch trái/trên một chút để căn mép) -->
    <Image x:Name="LogoImage" Width="92" Height="92" HorizontalAlignment="Left" Margin="-12,-12,0,-8" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock x:Name="NameText" FontSize="24" FontWeight="Bold" Margin="0,14,0,0"/>
    <TextBlock x:Name="TaglineText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
    <TextBlock x:Name="DescText" Opacity=".8" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"/>

    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushX}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,18,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock x:Name="AuthorLabel" Opacity=".65" Margin="0,3"/><TextBlock x:Name="AuthorValue" Grid.Column="1" FontWeight="SemiBold" Margin="0,3"/>
        <TextBlock x:Name="VersionLabel" Grid.Row="1" Opacity=".65" Margin="0,3"/><TextBlock x:Name="VersionValue" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Margin="0,3"/>
        <TextBlock x:Name="WebsiteLabel" Grid.Row="2" Opacity=".65" Margin="0,3"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,3"><Hyperlink x:Name="WebsiteLink" Click="Website_Click"><TextBlock x:Name="WebsiteText"/></Hyperlink></TextBlock>
        <TextBlock x:Name="BuiltLabel" Grid.Row="3" Opacity=".65" Margin="0,3"/><TextBlock x:Name="BuiltValue" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
      </Grid>
    </Border>

    <TextBlock x:Name="ThanksText" TextWrapping="Wrap" Margin="0,16,0,0"/>
    <TextBlock x:Name="CopyrightText" Opacity=".55" FontSize="11" Margin="0,6,0,0"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="UpdateButton" Margin="0,0,8,0" Click="Update_Click"/>
      <Button x:Name="DonateButton" Visibility="Collapsed" Background="#FFDB2777" Foreground="White" BorderThickness="0" Margin="0,0,8,0" Click="Donate_Click"/>
      <Button x:Name="CloseButton" IsCancel="True" IsDefault="True" Click="Close_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
