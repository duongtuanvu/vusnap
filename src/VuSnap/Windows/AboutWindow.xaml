<Window x:Class="VuSnap.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <StackPanel Margin="26,24,26,22">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
      <Border Width="54" Height="54" CornerRadius="14" Background="#FF181C3A" Margin="0,0,14,0">
        <Image x:Name="LogoImage" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="NameText" FontSize="22" FontWeight="Bold"/>
        <TextBlock x:Name="TaglineText" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>
    <TextBlock x:Name="DescText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="20"/>

    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushX}" BorderThickness="1" CornerRadius="14" Padding="15,12" Margin="0,16,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock x:Name="AuthorLabel" Foreground="{DynamicResource MutedBrush}" Margin="0,4"/><TextBlock x:Name="AuthorValue" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4"/>
        <TextBlock x:Name="VersionLabel" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" Margin="0,4"/><TextBlock x:Name="VersionValue" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Margin="0,4"/>
        <TextBlock x:Name="WebsiteLabel" Grid.Row="2" Foreground="{DynamicResource MutedBrush}" Margin="0,4"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4"><Hyperlink x:Name="WebsiteLink" Foreground="{DynamicResource AccentTextBrush}" Click="Website_Click"><TextBlock x:Name="WebsiteText" Foreground="{DynamicResource AccentTextBrush}"/></Hyperlink></TextBlock>
        <TextBlock x:Name="BuiltLabel" Grid.Row="3" Foreground="{DynamicResource MutedBrush}" Margin="0,4"/><TextBlock x:Name="BuiltValue" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Margin="0,4"/>
      </Grid>
    </Border>

    <TextBlock x:Name="ThanksText" TextWrapping="Wrap" Margin="0,14,0,0"/>
    <TextBlock x:Name="CopyrightText" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="UpdateButton" Margin="0,0,8,0" Click="Update_Click"/>
      <Button x:Name="DonateButton" Visibility="Collapsed" Background="#FFDB2777" Foreground="White" BorderThickness="0" Margin="0,0,8,0" Click="Donate_Click"/>
      <Button x:Name="CloseButton" Style="{StaticResource GradientButton}" Height="36" FontSize="13" IsCancel="True" IsDefault="True" Click="Close_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
