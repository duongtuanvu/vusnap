<Window x:Class="VuSnap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="VuSnap" Width="476" Height="800" MinWidth="440" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="58" CornerRadius="18" GlassFrameThickness="1" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <Grid Grid.Row="0" Margin="20,16,16,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Width="32" Height="32" Margin="0,0,10,0" Source="/Assets/app-logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="VuSnap" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
          <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrushX}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="9,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="VersionBadge" Text="v0.5.0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"/>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="HelpButton" Style="{StaticResource IconButton}" Click="Help_Click" Margin="0,0,2,0">
            <mi:MaterialIcon Kind="HelpCircleOutline" Width="18" Height="18"/>
            <Button.ContextMenu>
              <ContextMenu x:Name="HelpMenu">
                <MenuItem x:Name="MenuAbout" Click="Info_Click"/>
                <MenuItem x:Name="MenuFeatures" Click="Features_Click"/>
                <MenuItem x:Name="MenuHowTo" Click="HowTo_Click"/>
                <Separator x:Name="MenuSep"/>
                <MenuItem x:Name="MenuDonate" Click="Donate_Click" Visibility="Collapsed"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="MinButton" Style="{StaticResource IconButton}" Click="Minimize_Click" Margin="0,0,2,0">
            <mi:MaterialIcon Kind="Minus" Width="18" Height="18"/>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Click="CloseWin_Click">
            <mi:MaterialIcon Kind="Close" Width="17" Height="17"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Toast / Countdown Banner -->
      <Border x:Name="StatusBanner" Grid.Row="1" Margin="20,0,20,10" Padding="12,8" CornerRadius="11"
              Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="CancelCaptureButton" DockPanel.Dock="Right" Padding="10,4" MinHeight="26" FontSize="11.5" Margin="8,0,0,0"
                  Click="CancelCapture_Click" Visibility="Collapsed"/>
          <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <!-- 4 Tab Pages -->
      <Grid Grid.Row="2" Margin="20,0,20,12">
        <!-- TAB 1: CAPTURE -->
        <Grid x:Name="PageCapture" Visibility="Visible">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <!-- Primary 3-up Mode Bar -->
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushX}" BorderThickness="1" CornerRadius="13" Padding="4">
              <UniformGrid Columns="3">
                <RadioButton x:Name="ModeRegion" Style="{StaticResource SegmentRadio}" GroupName="CapMode" Tag="Region" Checked="ModeRadio_Checked">
                  <StackPanel Orientation="Horizontal">
                    <mi:MaterialIcon Kind="Selection" Width="15" Height="15" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    <TextBlock x:Name="ModeRegionText" Text="Region" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ModeActiveWindow" Style="{StaticResource SegmentRadio}" GroupName="CapMode" Tag="ActiveWindow" Checked="ModeRadio_Checked">
                  <StackPanel Orientation="Horizontal">
                    <mi:MaterialIcon Kind="ApplicationOutline" Width="15" Height="15" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    <TextBlock x:Name="ModeActiveWindowText" Text="Window" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ModeMonitor" Style="{StaticResource SegmentRadio}" GroupName="CapMode" Tag="Monitor" Checked="ModeRadio_Checked">
                  <StackPanel Orientation="Horizontal">
                    <mi:MaterialIcon Kind="Monitor" Width="15" Height="15" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                    <TextBlock x:Name="ModeMonitorText" Text="Monitor" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                  </StackPanel>
                </RadioButton>
              </UniformGrid>
            </Border>

            <!-- Secondary capture modes -->
            <WrapPanel Margin="0,8,0,10" HorizontalAlignment="Center">
              <RadioButton x:Name="ModeDesktop" Style="{StaticResource ChipRadio}" GroupName="CapMode" Tag="Desktop" Margin="0,0,5,5" Checked="ModeRadio_Checked"/>
              <RadioButton x:Name="ModeWindowPicker" Style="{StaticResource ChipRadio}" GroupName="CapMode" Tag="WindowPicker" Margin="0,0,5,5" Checked="ModeRadio_Checked"/>
              <RadioButton x:Name="ModeWindowHover" Style="{StaticResource ChipRadio}" GroupName="CapMode" Tag="WindowHover" Margin="0,0,5,5" Checked="ModeRadio_Checked"/>
              <RadioButton x:Name="ModeRepeat" Style="{StaticResource ChipRadio}" GroupName="CapMode" Tag="Repeat" Margin="0,0,5,5" Checked="ModeRadio_Checked"/>
              <RadioButton x:Name="ModeColorPicker" Style="{StaticResource ChipRadio}" GroupName="CapMode" Tag="ColorPicker" Margin="0,0,5,5" Checked="ModeRadio_Checked"/>
              <RadioButton x:Name="ModeScrolling" Style="{StaticResource ChipRadio}" GroupName="CapMode" Tag="Scrolling" Margin="0,0,0,5" Checked="ModeRadio_Checked"/>
            </WrapPanel>

            <!-- Delay -->
            <Border Style="{StaticResource WellCard}" Margin="0,0,0,9">
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="ClockOutline" Width="17" Height="17" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,9,0"/>
                  <TextBlock x:Name="CaptureDelayLabel" Style="{StaticResource SmallLabel}"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="10" Padding="3">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Delay0" Style="{StaticResource SegmentRadio}" GroupName="CapDelay" Tag="0" Padding="9,4" FontSize="12" Checked="DelayRadio_Checked"/>
                    <RadioButton x:Name="Delay3" Style="{StaticResource SegmentRadio}" GroupName="CapDelay" Tag="3" Padding="9,4" FontSize="12" Checked="DelayRadio_Checked"/>
                    <RadioButton x:Name="Delay5" Style="{StaticResource SegmentRadio}" GroupName="CapDelay" Tag="5" Padding="9,4" FontSize="12" Checked="DelayRadio_Checked"/>
                    <RadioButton x:Name="Delay10" Style="{StaticResource SegmentRadio}" GroupName="CapDelay" Tag="10" Padding="9,4" FontSize="12" Checked="DelayRadio_Checked"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <!-- Global Hotkey -->
            <Border Style="{StaticResource WellCard}" Margin="0,0,0,9">
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="KeyboardOutline" Width="17" Height="17" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,9,0"/>
                  <TextBlock x:Name="HotkeyLabel" Style="{StaticResource SmallLabel}"/>
                </StackPanel>
                <TextBox x:Name="HotkeyBox" Style="{StaticResource KeycapBox}" HorizontalAlignment="Right" MinWidth="128" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
              </Grid>
            </Border>

            <!-- Magnifier Toggle -->
            <Border Style="{StaticResource WellCard}" Margin="0,0,0,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <mi:MaterialIcon Kind="MagnifyPlusOutline" Width="17" Height="17" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="LoupeLabel" Grid.Column="1" Style="{StaticResource SmallLabel}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                <CheckBox x:Name="LoupeBox" Grid.Column="2" Style="{StaticResource ProToggle}" Checked="Display_Changed" Unchecked="Display_Changed"/>
              </Grid>
            </Border>

            <!-- Auto-copy Toggle -->
            <Border Style="{StaticResource WellCard}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <mi:MaterialIcon Kind="ContentCopy" Width="16" Height="16" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="CopyAfterLabel" Grid.Column="1" Style="{StaticResource SmallLabel}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                <CheckBox x:Name="CopyAfterBox" Grid.Column="2" Style="{StaticResource ProToggle}" Checked="CopyAfter_Changed" Unchecked="CopyAfter_Changed"/>
              </Grid>
            </Border>

            <!-- Hero Primary CTA -->
            <Button x:Name="CaptureNowButton" Style="{StaticResource GradientButton}" Click="CaptureNow_Click"/>

            <!-- Shortcut hint -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
              <TextBlock x:Name="OrPressText" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
              <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1,1,1,2" CornerRadius="6" Padding="7,2" Margin="6,0">
                <TextBlock x:Name="HotkeyHintChip" FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="SemiBold"/>
              </Border>
              <TextBlock x:Name="AnywhereText" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>

          <!-- 3-Step Workflow Strip pinned cleanly at bottom of Capture tab -->
          <UniformGrid Grid.Row="2" Columns="3" Margin="0,8,0,2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Border Width="20" Height="20" CornerRadius="10" Background="#FF181C3A" Margin="0,0,6,0">
                <TextBlock Text="1" Foreground="{DynamicResource MintBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="Step1Text" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Border Width="20" Height="20" CornerRadius="10" Background="#FF181C3A" Margin="0,0,6,0">
                <TextBlock Text="2" Foreground="{DynamicResource MintBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="Step2Text" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Border Width="20" Height="20" CornerRadius="10" Background="#FF181C3A" Margin="0,0,6,0">
                <TextBlock Text="3" Foreground="{DynamicResource MintBrush}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="Step3Text" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </UniformGrid>
        </Grid>

        <!-- TAB 2: TOOLS & SHORTCUTS -->
        <Grid x:Name="PageTools" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Search Box -->
          <Grid Grid.Row="0" Margin="0,0,0,9">
            <TextBox x:Name="SearchBox" Height="38" Padding="34,4,32,4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushX}" TextChanged="SearchBox_TextChanged"/>
            <mi:MaterialIcon Kind="Magnify" Width="17" Height="17" Foreground="{DynamicResource MutedBrush}" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock x:Name="SearchPlaceholder" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Button x:Name="SearchClear" Style="{StaticResource IconButton}" Width="26" Height="26" HorizontalAlignment="Right" Margin="0,0,6,0" Visibility="Collapsed" Click="SearchClear_Click"/>
          </Grid>

          <!-- Category Filter Pills -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="FilterAll" Style="{StaticResource ChipRadio}" GroupName="ToolFilter" Tag="All" IsChecked="True" Margin="0,0,6,0" Checked="ToolFilter_Changed"/>
            <RadioButton x:Name="FilterTools" Style="{StaticResource ChipRadio}" GroupName="ToolFilter" Tag="Tools" Margin="0,0,6,0" Checked="ToolFilter_Changed"/>
            <RadioButton x:Name="FilterToolbar" Style="{StaticResource ChipRadio}" GroupName="ToolFilter" Tag="Toolbar" Margin="0,0,6,0" Checked="ToolFilter_Changed"/>
            <RadioButton x:Name="FilterActions" Style="{StaticResource ChipRadio}" GroupName="ToolFilter" Tag="Actions" Checked="ToolFilter_Changed"/>
          </StackPanel>

          <!-- Tool & Shortcut List -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TableRows" Margin="0,0,4,0"/>
          </ScrollViewer>

          <!-- Footer Actions -->
          <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="TableHint" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6"/>
            <DockPanel>
              <Button x:Name="ResetShortcutsButton" DockPanel.Dock="Left" Style="{StaticResource GhostLinkButton}" Click="ResetShortcuts_Click"/>
              <Button x:Name="ResetOrderButton" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource GhostLinkButton}" Click="ResetOrder_Click"/>
            </DockPanel>
          </StackPanel>
        </Grid>

        <!-- TAB 3: TOOLBAR & ANNOTATION DEFAULTS -->
        <ScrollViewer x:Name="PageToolbar" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,4,0">
            <!-- Spatial Dock Card -->
            <Border Style="{StaticResource WellCard}" Margin="0,0,0,9">
              <StackPanel>
                <TextBlock x:Name="PosTitle" Style="{StaticResource SectionCaps}" Margin="0,0,0,10"/>
                <Grid HorizontalAlignment="Center">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="168"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="66"/><RowDefinition Height="32"/></Grid.RowDefinitions>
                  <RadioButton x:Name="PosTop" Grid.Column="1" Style="{StaticResource PosButton}" GroupName="Pos" Tag="Top" Margin="4,0" Checked="Pos_Checked"/>
                  <RadioButton x:Name="PosLeft" Grid.Row="1" Style="{StaticResource PosButton}" GroupName="Pos" Tag="Left" Margin="0,4" Checked="Pos_Checked"/>
                  <Grid Grid.Row="1" Grid.Column="1" Margin="4">
                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"/>
                    <Rectangle Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeDashArray="4 3" RadiusX="9" RadiusY="9" Opacity="0.7"/>
                    <TextBlock x:Name="PosCenter" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                  </Grid>
                  <RadioButton x:Name="PosRight" Grid.Row="1" Grid.Column="2" Style="{StaticResource PosButton}" GroupName="Pos" Tag="Right" Margin="0,4" Checked="Pos_Checked"/>
                  <RadioButton x:Name="PosBottom" Grid.Row="2" Grid.Column="1" Style="{StaticResource PosButton}" GroupName="Pos" Tag="Bottom" Margin="4,0" Checked="Pos_Checked"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Behavior Toggles -->
            <Border Style="{StaticResource WellCard}" Margin="0,0,0,8">
              <Grid>
                <TextBlock x:Name="MergeLabel" Style="{StaticResource SmallLabel}" TextWrapping="Wrap" Margin="0,0,50,0"/>
                <CheckBox x:Name="MergeBox" Style="{StaticResource ProToggle}" Checked="Display_Changed" Unchecked="Display_Changed"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource WellCard}" Margin="0,0,0,8">
              <Grid>
                <TextBlock x:Name="SplitLabel" Style="{StaticResource SmallLabel}" TextWrapping="Wrap" Margin="0,0,50,0"/>
                <CheckBox x:Name="SplitBox" Style="{StaticResource ProToggle}" Checked="Display_Changed" Unchecked="Display_Changed"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource WellCard}" Margin="0,0,0,8">
              <Grid>
                <TextBlock x:Name="HintsLabel" Style="{StaticResource SmallLabel}" TextWrapping="Wrap" Margin="0,0,50,0"/>
                <CheckBox x:Name="HintsBox" Style="{StaticResource ProToggle}" Checked="Display_Changed" Unchecked="Display_Changed"/>
              </Grid>
            </Border>

            <!-- Selected-object Outline Opacity -->
            <Border Style="{StaticResource WellCard}" Margin="0,0,0,9">
              <StackPanel>
                <Grid Margin="0,0,0,4">
                  <TextBlock x:Name="OutlineTitle" Style="{StaticResource SmallLabel}" TextWrapping="Wrap" Margin="0,0,48,0"/>
                  <TextBlock x:Name="OutlineValue" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions>
                  <Slider x:Name="OutlineSlider" Minimum="10" Maximum="100" Value="20" ValueChanged="OutlineSlider_Changed" Margin="0,0,12,0"/>
                  <Border Grid.Column="1" Height="24" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrushX}" BorderThickness="1" CornerRadius="6">
                    <Rectangle x:Name="OutlinePreview" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeDashArray="3 2" Margin="4"/>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Default Annotation Styles -->
            <Border Style="{StaticResource WellCard}">
              <StackPanel>
                <TextBlock x:Name="DefTitle" Style="{StaticResource SectionCaps}" Margin="0,0,0,8"/>

                <TextBlock x:Name="DefColorLabel" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border x:Name="DefColorPreview" Width="28" Height="28" CornerRadius="8" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" HorizontalAlignment="Left"/>
                  <TextBox x:Name="DefHex" Grid.Column="1" MinHeight="28" Padding="8,2" FontFamily="Cascadia Mono, Consolas" FontSize="12" KeyDown="DefHex_KeyDown" LostFocus="DefHex_LostFocus"/>
                  <WrapPanel x:Name="DefSwatches" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <Grid><TextBlock x:Name="DefThickLabel" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/><TextBlock x:Name="DefThickValue" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/></Grid>
                    <Slider x:Name="DefThickSlider" Minimum="1" Maximum="40" Value="4" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="DefThick_Changed"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Grid><TextBlock x:Name="DefOpacityLabel" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/><TextBlock x:Name="DefOpacityValue" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/></Grid>
                    <Slider x:Name="DefOpacitySlider" Minimum="5" Maximum="100" Value="100" ValueChanged="DefOpacity_Changed"/>
                  </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="DefStrokeLabel" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="DefStrokeBox" SelectionChanged="DefStroke_Changed"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock x:Name="DefAspectLabel" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="DefAspectBox" SelectionChanged="DefAspect_Changed"/>
                  </StackPanel>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="DefArrowLabel" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="DefArrowBox" SelectionChanged="DefArrow_Changed"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock x:Name="DefLineTypeLabel" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="DefLineTypeBox" SelectionChanged="DefLineType_Changed"/>
                  </StackPanel>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="DefZoomLabel" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="DefZoomBox" SelectionChanged="DefZoom_Changed"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock x:Name="DefLensLabel" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="DefLensBox" SelectionChanged="DefLens_Changed"/>
                  </StackPanel>
                </Grid>

                <TextBlock x:Name="DefFontLabel" Style="{StaticResource FieldLabel}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions>
                  <ComboBox x:Name="DefFontBox" DropDownOpened="DefFontBox_DropDownOpened" SelectionChanged="DefFont_Changed"/>
                  <ComboBox x:Name="DefWeightBox" Grid.Column="2" SelectionChanged="DefWeight_Changed"/>
                </Grid>
                <TextBlock x:Name="DefWeightLabel" Visibility="Collapsed"/>

                <WrapPanel Margin="0,10,0,2">
                  <CheckBox x:Name="DefItalicBox" Margin="0,0,16,4" Checked="DefFontStyle_Changed" Unchecked="DefFontStyle_Changed"/>
                  <CheckBox x:Name="DefCornersBox" Margin="0,0,0,4" Checked="DefCorners_Changed" Unchecked="DefCorners_Changed"/>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- TAB 4: GENERAL & SAVING -->
        <ScrollViewer x:Name="PageGeneral" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,4,0">
            <!-- Language -->
            <Border Style="{StaticResource WellCard}" Margin="0,0,0,9">
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="Web" Width="17" Height="17" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,9,0"/>
                  <TextBlock x:Name="LangLabel" Style="{StaticResource SmallLabel}"/>
                </StackPanel>
                <ComboBox x:Name="LangBox" HorizontalAlignment="Right" Width="136" SelectionChanged="LangBox_SelectionChanged">
                  <ComboBoxItem Tag="en" Content="English"/><ComboBoxItem Tag="vi" Content="Tiếng Việt"/>
                </ComboBox>
              </Grid>
            </Border>

            <!-- Theme Segmented Control -->
            <Border Style="{StaticResource WellCard}" Margin="0,0,0,9">
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <mi:MaterialIcon Kind="ThemeLightDark" Width="17" Height="17" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,9,0"/>
                  <TextBlock x:Name="ThemeLabel" Style="{StaticResource SmallLabel}"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="10" Padding="3">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ThemeLightRadio" Style="{StaticResource SegmentRadio}" GroupName="ThemeSeg" Tag="Light" Padding="10,4" FontSize="12" Checked="ThemeRadio_Checked"/>
                    <RadioButton x:Name="ThemeDarkRadio" Style="{StaticResource SegmentRadio}" GroupName="ThemeSeg" Tag="Dark" Padding="10,4" FontSize="12" Checked="ThemeRadio_Checked"/>
                    <RadioButton x:Name="ThemeSystemRadio" Style="{StaticResource SegmentRadio}" GroupName="ThemeSeg" Tag="System" Padding="10,4" FontSize="12" Checked="ThemeRadio_Checked"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <!-- Saving & Format -->
            <Border Style="{StaticResource WellCard}" Margin="0,0,0,9">
              <StackPanel>
                <Grid Margin="0,0,0,9">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <mi:MaterialIcon Kind="FolderOutline" Width="17" Height="17" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,9,0"/>
                    <TextBlock x:Name="SaveDirLabel" Style="{StaticResource SmallLabel}"/>
                  </StackPanel>
                  <Border HorizontalAlignment="Right" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="10" Padding="3">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="FmtPngRadio" Style="{StaticResource SegmentRadio}" GroupName="FormatSeg" Tag="PNG" Content="PNG" Padding="10,3" FontSize="11.5" Checked="FormatRadio_Checked"/>
                      <RadioButton x:Name="FmtJpgRadio" Style="{StaticResource SegmentRadio}" GroupName="FormatSeg" Tag="JPG" Content="JPG" Padding="10,3" FontSize="11.5" Checked="FormatRadio_Checked"/>
                    </StackPanel>
                  </Border>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="SaveDirBox" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" TextWrapping="NoWrap" KeyDown="SaveDir_KeyDown" LostFocus="SaveDir_LostFocus"/>
                  <Button x:Name="BrowseButton" Grid.Column="1" Margin="6,0,0,0" Padding="9,5" Click="BrowseSaveDir_Click"/>
                  <Button x:Name="OpenDirButton" Grid.Column="2" Margin="6,0,0,0" Padding="9,5" Click="OpenSaveDir_Click"/>
                </Grid>
                <TextBlock x:Name="SaveFormatLabel" Visibility="Collapsed"/>
              </StackPanel>
            </Border>

            <!-- System Toggles -->
            <Border Style="{StaticResource WellCard}" Margin="0,0,0,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <mi:MaterialIcon Kind="Power" Width="17" Height="17" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StartLabel" Grid.Column="1" Style="{StaticResource SmallLabel}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                <CheckBox x:Name="StartBox" Grid.Column="2" Style="{StaticResource ProToggle}" Checked="System_Changed" Unchecked="System_Changed"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource WellCard}" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <mi:MaterialIcon Kind="TrayArrowDown" Width="17" Height="17" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TrayLabel" Grid.Column="1" Style="{StaticResource SmallLabel}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                <CheckBox x:Name="TrayBox" Grid.Column="2" Style="{StaticResource ProToggle}" Checked="System_Changed" Unchecked="System_Changed"/>
              </Grid>
            </Border>

            <!-- Import / Export / Restore -->
            <UniformGrid Columns="3" Margin="0,0,0,10">
              <Button x:Name="ImportButton" Margin="0,0,6,0" Padding="8,6" Click="Import_Click"/>
              <Button x:Name="ExportButton" Margin="3,0" Padding="8,6" Click="Export_Click"/>
              <Button x:Name="ResetButton" Margin="6,0,0,0" Padding="8,6" Foreground="{DynamicResource DangerTextBrush}" Click="Reset_Click"/>
            </UniformGrid>

            <!-- Info / Features / HowTo -->
            <UniformGrid Columns="3" Margin="0,0,0,12">
              <Button x:Name="InfoButton" Margin="0,0,6,0" Padding="8,6" FontSize="12" Click="Info_Click"/>
              <Button x:Name="FeaturesButton" Margin="3,0" Padding="8,6" FontSize="12" Click="Features_Click"/>
              <Button x:Name="HowToButton" Margin="6,0,0,0" Padding="8,6" FontSize="12" Click="HowTo_Click"/>
            </UniformGrid>
            <Button x:Name="DonateButton" Visibility="Collapsed" Margin="0,0,0,10" Background="#FFDB2777" Foreground="White" BorderThickness="0" Click="Donate_Click"/>

            <!-- Tray Status Indicator -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource MintBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="TrayStatusText" Style="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- Bottom Navigation Bar -->
      <Border Grid.Row="3" Background="{DynamicResource NavBgBrush}" BorderBrush="{DynamicResource BorderBrushX}" BorderThickness="0,1,0,0" Padding="12,8,12,10">
        <UniformGrid Columns="4">
          <RadioButton x:Name="NavCapture" Style="{StaticResource NavTabRadio}" GroupName="MainNav" Tag="Capture" IsChecked="True" Checked="NavTab_Checked">
            <StackPanel HorizontalAlignment="Center">
              <mi:MaterialIcon Kind="CropFree" Width="19" Height="19" Margin="0,0,0,3" HorizontalAlignment="Center"/>
              <TextBlock x:Name="NavCaptureLabel" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavTools" Style="{StaticResource NavTabRadio}" GroupName="MainNav" Tag="Tools" Checked="NavTab_Checked">
            <StackPanel HorizontalAlignment="Center">
              <mi:MaterialIcon Kind="PencilRuler" Width="19" Height="19" Margin="0,0,0,3" HorizontalAlignment="Center"/>
              <TextBlock x:Name="NavToolsLabel" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavToolbar" Style="{StaticResource NavTabRadio}" GroupName="MainNav" Tag="Toolbar" Checked="NavTab_Checked">
            <StackPanel HorizontalAlignment="Center">
              <mi:MaterialIcon Kind="DockBottom" Width="19" Height="19" Margin="0,0,0,3" HorizontalAlignment="Center"/>
              <TextBlock x:Name="NavToolbarLabel" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavGeneral" Style="{StaticResource NavTabRadio}" GroupName="MainNav" Tag="General" Checked="NavTab_Checked">
            <StackPanel HorizontalAlignment="Center">
              <mi:MaterialIcon Kind="TuneVariant" Width="19" Height="19" Margin="0,0,0,3" HorizontalAlignment="Center"/>
              <TextBlock x:Name="NavGeneralLabel" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </StackPanel>
          </RadioButton>
        </UniformGrid>
      </Border>
    </Grid>
  </Grid>
</Window>
