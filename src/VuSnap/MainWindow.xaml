<Window x:Class="VuSnap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="VuSnap" Width="1000" Height="820" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#FFF5F6F8"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FF172033"/>
    <SolidColorBrush x:Key="BorderBrushX" Color="#FFDADEE5"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="#FFF7F8FA"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#FFEDF0F4"/>
    <SolidColorBrush x:Key="SelRowBrush" Color="#FFE3ECFF"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#FFF1F3F6"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF2563EB"/>

    <!-- ── Text / Card / Divider ── -->
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Opacity" Value="0.65"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SmallLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Opacity" Value="0.8"/><Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Opacity" Value="0.75"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,12,0,4"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrushX}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style x:Key="Divider" TargetType="Border">
      <Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource BorderBrushX}"/><Setter Property="Margin" Value="0,18,0,16"/>
    </Style>

    <!-- ── Button: bo góc, hover/pressed bằng độ mờ (dùng được cả với nút có màu riêng) ── -->
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushX}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.86"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Nút biểu tượng nhỏ (✕ trong bảng) -->
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="12"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── TextBox: bo góc, viền xanh khi focus ── -->
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushX}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ── ComboBox: bo góc, popup phẳng ── -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonBrush}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="7" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrushX}" BorderThickness="1">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" Data="M0,0 L4,4 L8,0"
                            Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.7"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
              <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border MinWidth="{Binding ActualWidth, ElementName=Toggle}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,0,0" CornerRadius="8"
                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushX}" BorderThickness="1">
                  <ScrollViewer Margin="3" SnapsToDevicePixels="True"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,5,0,5"/></Style>

    <!-- Nút chọn vị trí thanh tool -->
    <Style x:Key="PosButton" TargetType="RadioButton">
      <Setter Property="Width" Value="76"/><Setter Property="Height" Value="34"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource BorderBrushX}" Background="{DynamicResource ButtonBrush}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="20,18,20,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Cài đặt chung: một hàng + dòng trạng thái -->
    <Border Style="{StaticResource Card}" Padding="20,14">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="LangLabel" Style="{StaticResource SmallLabel}"/>
          <ComboBox x:Name="LangBox" Grid.Column="1" Margin="0,0,28,0" SelectionChanged="LangBox_SelectionChanged">
            <ComboBoxItem Tag="en" Content="English"/><ComboBoxItem Tag="vi" Content="Tiếng Việt"/>
          </ComboBox>
          <TextBlock x:Name="ThemeLabel" Grid.Column="2" Style="{StaticResource SmallLabel}"/>
          <ComboBox x:Name="ThemeBox" Grid.Column="3" Margin="0,0,28,0" SelectionChanged="ThemeBox_SelectionChanged">
            <ComboBoxItem Tag="Light"/><ComboBoxItem Tag="Dark"/><ComboBoxItem Tag="System"/>
          </ComboBox>
          <TextBlock x:Name="HotkeyLabel" Grid.Column="4" Style="{StaticResource SmallLabel}"/>
          <TextBox x:Name="HotkeyBox" Grid.Column="5" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Arrow" TextAlignment="Center" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
          <Button x:Name="ResetButton" Grid.Column="7" Margin="0" Click="Reset_Click"/>
        </Grid>
        <WrapPanel Margin="0,12,0,0">
          <TextBlock x:Name="CaptureModeLabel" Style="{StaticResource SmallLabel}"/>
          <ComboBox x:Name="CaptureModeBox" Width="180" Margin="0,0,12,0" SelectionChanged="CapturePreferences_Changed">
            <ComboBoxItem Tag="Region"/><ComboBoxItem Tag="Monitor"/><ComboBoxItem Tag="Desktop"/><ComboBoxItem Tag="ActiveWindow"/><ComboBoxItem Tag="WindowPicker"/><ComboBoxItem Tag="WindowHover"/><ComboBoxItem Tag="Repeat"/>
          </ComboBox>
          <TextBlock x:Name="CaptureDelayLabel" Style="{StaticResource SmallLabel}"/>
          <ComboBox x:Name="CaptureDelayBox" Width="100" Margin="0,0,12,0" SelectionChanged="CapturePreferences_Changed">
            <ComboBoxItem Tag="0"/><ComboBoxItem Tag="3"/><ComboBoxItem Tag="5"/><ComboBoxItem Tag="10"/>
          </ComboBox>
          <Button x:Name="CaptureNowButton" Click="CaptureNow_Click" Margin="0,0,8,0"/>
          <Button x:Name="CancelCaptureButton" Click="CancelCapture_Click" IsEnabled="False"/>
        </WrapPanel>
        <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="0,10,0,0" Visibility="Collapsed"/>
      </StackPanel>
    </Border>

    <!-- Thân: tùy chọn hiển thị (trái) | bảng nút & phím tắt (phải) -->
    <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="20,18,20,20">
            <!-- Hệ thống: đặt trên cùng -->
            <TextBlock x:Name="SysTitle" Style="{StaticResource Section}" Margin="0,0,0,4"/>
            <CheckBox x:Name="StartBox" Checked="System_Changed" Unchecked="System_Changed"/>
            <CheckBox x:Name="TrayBox" Checked="System_Changed" Unchecked="System_Changed"/>
            <Border Style="{StaticResource Divider}"/>

            <!-- Vị trí thanh công cụ: sơ đồ trực quan -->
            <TextBlock x:Name="PosTitle" Style="{StaticResource Section}"/>
            <Grid HorizontalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <RadioButton x:Name="PosTop" Grid.Column="1" Width="150" Height="30" Style="{StaticResource PosButton}" GroupName="Pos" Tag="Top" Checked="Pos_Checked"/>
              <RadioButton x:Name="PosLeft" Grid.Row="1" Width="34" Height="76" Style="{StaticResource PosButton}" GroupName="Pos" Tag="Left" Checked="Pos_Checked"/>
              <Grid Grid.Row="1" Grid.Column="1" Width="150" Height="76" Margin="3">
                <Rectangle Stroke="{DynamicResource BorderBrushX}" StrokeThickness="1.5" StrokeDashArray="4 3" RadiusX="6" RadiusY="6" Fill="{DynamicResource RowAltBrush}"/>
                <TextBlock x:Name="PosCenter" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Opacity=".55"/>
              </Grid>
              <RadioButton x:Name="PosRight" Grid.Row="1" Grid.Column="2" Width="34" Height="76" Style="{StaticResource PosButton}" GroupName="Pos" Tag="Right" Checked="Pos_Checked"/>
              <RadioButton x:Name="PosBottom" Grid.Row="2" Grid.Column="1" Width="150" Height="30" Style="{StaticResource PosButton}" GroupName="Pos" Tag="Bottom" Checked="Pos_Checked"/>
            </Grid>

            <CheckBox x:Name="MergeBox" Margin="0,16,0,0" Checked="Display_Changed" Unchecked="Display_Changed"/>
            <CheckBox x:Name="SplitBox" Checked="Display_Changed" Unchecked="Display_Changed"/>
            <CheckBox x:Name="HintsBox" Checked="Display_Changed" Unchecked="Display_Changed"/>
            <CheckBox x:Name="LoupeBox" Checked="Display_Changed" Unchecked="Display_Changed"/>

            <Border Style="{StaticResource Divider}"/>
            <TextBlock x:Name="OutlineTitle" Style="{StaticResource Section}" TextWrapping="Wrap"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Slider x:Name="OutlineSlider" Minimum="10" Maximum="100" Value="100" ValueChanged="OutlineSlider_Changed" VerticalAlignment="Center"/>
              <TextBlock x:Name="OutlineValue" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Width="40" TextAlignment="Right"/>
            </Grid>
            <Border Height="30" Margin="0,8,0,0" Background="#FFBFC3C9" CornerRadius="6">
              <Rectangle x:Name="OutlinePreview" Stroke="#FF0A64FF" StrokeThickness="1" StrokeDashArray="4 3" Margin="6"/>
            </Border>

            <Border Style="{StaticResource Divider}"/>
            <TextBlock x:Name="DefTitle" Style="{StaticResource Section}" Margin="0,0,0,2"/>
            <TextBlock x:Name="DefColorLabel" Style="{StaticResource FieldLabel}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="DefColorPreview" Width="32" Height="32" CornerRadius="7" BorderBrush="{DynamicResource BorderBrushX}" BorderThickness="1" Margin="0,0,8,0"/>
              <TextBox x:Name="DefHex" Grid.Column="1" KeyDown="DefHex_KeyDown" LostFocus="DefHex_LostFocus"/>
            </Grid>
            <WrapPanel x:Name="DefSwatches" Margin="0,8,0,0"/>

            <TextBlock x:Name="DefThickLabel" Style="{StaticResource FieldLabel}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Slider x:Name="DefThickSlider" Minimum="1" Maximum="40" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="DefThick_Changed"/>
              <TextBlock x:Name="DefThickValue" Grid.Column="1" Margin="10,0,0,0" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="DefOpacityLabel" Style="{StaticResource FieldLabel}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Slider x:Name="DefOpacitySlider" Minimum="5" Maximum="100" Value="100" VerticalAlignment="Center" ValueChanged="DefOpacity_Changed"/>
              <TextBlock x:Name="DefOpacityValue" Grid.Column="1" Margin="10,0,0,0" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="DefStrokeLabel" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="DefStrokeBox" SelectionChanged="DefStroke_Changed"/>

            <TextBlock x:Name="DefAspectLabel" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="DefAspectBox" SelectionChanged="DefAspect_Changed"/>

            <TextBlock x:Name="DefArrowLabel" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="DefArrowBox" SelectionChanged="DefArrow_Changed"/>

            <CheckBox x:Name="DefCornersBox" Margin="0,12,0,0" Checked="DefCorners_Changed" Unchecked="DefCorners_Changed"/>

            <TextBlock x:Name="DefZoomLabel" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="DefZoomBox" SelectionChanged="DefZoom_Changed"/>

            <TextBlock x:Name="DefLensLabel" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="DefLensBox" SelectionChanged="DefLens_Changed"/>

            <TextBlock x:Name="DefFontLabel" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="DefFontBox" DropDownOpened="DefFontBox_DropDownOpened" SelectionChanged="DefFont_Changed"/>
            <TextBlock x:Name="DefWeightLabel" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="DefWeightBox" SelectionChanged="DefWeight_Changed"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <CheckBox x:Name="DefItalicBox" Checked="DefFontStyle_Changed" Unchecked="DefFontStyle_Changed"/>
            </StackPanel>

            <TextBlock x:Name="DefLineTypeLabel" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="DefLineTypeBox" SelectionChanged="DefLineType_Changed"/>

            <Border Style="{StaticResource Divider}"/>
            <TextBlock x:Name="SaveTitle" Style="{StaticResource Section}" Margin="0,0,0,2"/>
            <TextBlock x:Name="SaveDirLabel" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="SaveDirBox" TextWrapping="NoWrap" KeyDown="SaveDir_KeyDown" LostFocus="SaveDir_LostFocus"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="BrowseButton" Padding="12,5" Click="BrowseSaveDir_Click"/>
              <Button x:Name="OpenDirButton" Padding="12,5" Click="OpenSaveDir_Click"/>
            </StackPanel>
            <TextBlock x:Name="SaveFormatLabel" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="SaveFormatBox" SelectionChanged="SaveFormat_Changed">
              <ComboBoxItem Tag="PNG" Content="PNG"/><ComboBoxItem Tag="JPG" Content="JPG"/>
            </ComboBox>
            <CheckBox x:Name="CopyAfterBox" Margin="0,12,0,5" Checked="CopyAfter_Changed" Unchecked="CopyAfter_Changed"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid Margin="18,16,18,16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="TableTitle" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock x:Name="TableHint" Grid.Row="1" Style="{StaticResource Muted}" Margin="0,4,0,10"/>
          <!-- Ô tìm kiếm công cụ -->
          <Grid Grid.Row="2" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" Padding="32,4,30,4" TextChanged="SearchBox_TextChanged"/>
            <mi:MaterialIcon Kind="Magnify" Width="17" Height="17" Opacity=".55" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock x:Name="SearchPlaceholder" Opacity=".45" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Button x:Name="SearchClear" Style="{StaticResource IconButton}" Width="26" Height="26" Content="✕" HorizontalAlignment="Right" Margin="0,0,4,0" Visibility="Collapsed" Click="SearchClear_Click"/>
          </Grid>
          <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrushX}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <!-- Header cố định -->
              <Border Background="{DynamicResource HeaderBrush}" Padding="12,8,26,8">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="150"/><ColumnDefinition Width="40"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="ColName" FontWeight="SemiBold" FontSize="12"/>
                  <TextBlock x:Name="ColShow" Grid.Column="1" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="ColKey" Grid.Column="2" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                </Grid>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TableRows"/>
              </ScrollViewer>
            </Grid>
          </Border>
          <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="ResetShortcutsButton" Click="ResetShortcuts_Click"/>
            <Button x:Name="ResetOrderButton" Click="ResetOrder_Click"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Hàng nút: Thông tin / Tính năng / Cách dùng / Donate -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
      <Button x:Name="InfoButton" Padding="18,7" Click="Info_Click"/>
      <Button x:Name="FeaturesButton" Padding="18,7" Click="Features_Click"/>
      <Button x:Name="HowToButton" Padding="18,7" Click="HowTo_Click"/>
      <Button x:Name="DonateButton" Visibility="Collapsed" Padding="18,7" Background="#FFDB2777" Foreground="White" BorderThickness="0" Click="Donate_Click"/>
      <Button x:Name="ImportButton" Padding="18,7" Margin="32,0,0,0" Click="Import_Click"/>
      <Button x:Name="ExportButton" Padding="18,7" Margin="12,0,0,0" Click="Export_Click"/>
    </StackPanel>
  </Grid>
</Window>
