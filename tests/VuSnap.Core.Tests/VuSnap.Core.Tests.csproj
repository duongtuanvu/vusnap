<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Unqualified application pack URIs resolve against this test host's entry assembly. -->
    <Resource Include="../../src/VuSnap/Assets/app-fit.ico" Link="Assets/app-fit.ico" />
    <Resource Include="../../src/VuSnap/Assets/app-logo.png" Link="Assets/app-logo.png" />
    <ProjectReference Include="../../src/VuSnap/VuSnap.csproj" />
  </ItemGroup>
</Project>
